  "robot": {
    "labelLeft": "IN PROGRESS",
    "labelRight": "HUMANOID ROBOTICS · 2026",
    "title": "A robot for my mother.",
    "goal": "My mother’s back makes bending and lifting hard, so I’m building her a humanoid that does it for her: tidying, the dishwasher, wiping surfaces, laundry, fetch and carry. I’m buying the body and building the brain, from teleoperation to scheduled autonomy, always under supervision.",
    "panels": [
      {
        "name": "CLOUD · DECIDES WHAT",
        "nodes": [
          {
            "title": "Gemini Robotics ER 2",
            "sub": "LIVE TASK PLANNER"
          },
          {
            "title": "π model via Pi API",
            "sub": "MANIPULATION POLICY"
          },
          {
            "title": "Gemini 4 Argon",
            "sub": "SIMULATION AND DATA",
            "secondary": true
          }
        ],
        "arrows": [
          "ONE SUBTASK AT A TIME"
        ],
        "note": "I keep the cloud out of the balance loop: if the link drops, the robot still holds itself up."
      },
      {
        "name": "ROBOT · ACTS, SAFELY",
        "nodes": [
          {
            "title": "Policy runner",
            "sub": "JETSON AGX THOR"
          },
          {
            "title": "Safety layer",
            "sub": "HARD LIMITS UNDER EVERY POLICY"
          },
          {
            "title": "Whole-body control",
            "sub": "UNITREE G1 · ORIN NX"
          },
          {
            "title": "Motors and hands",
            "sub": "DEX3-1 TACTILE"
          }
        ],
        "note": "Link lost: it falls back to GR00T N1.7 or π0.5 on board, or stops safely."
      },
      {
        "name": "TRAINING · GETS BETTER",
        "nodes": [
          {
            "title": "Teleoperated demos",
            "sub": "QUEST 3 · LEROBOT"
          },
          {
            "title": "Fine-tune",
            "sub": "H100 · RTX 5090"
          },
          {
            "title": "Evaluate",
            "sub": "ISAAC LAB · MUJOCO"
          },
          {
            "title": "Deploy",
            "sub": "TO THE ROBOT"
          }
        ],
        "note": "Every failure chooses my next demonstration."
      }
    ],
    "links": {
      "cloudToRobot": "ACTION CHUNKS",
      "trainingToRobot": "EVALUATED POLICY"
    },
    "bar": "I PROMOTE A SKILL ONLY AT 80% SUCCESS OVER 50 TRIALS · ZERO SAFETY-STOP VIOLATIONS",
    "desc": "In progress: a robot for my mother. Her back makes bending and lifting hard, so I’m building her a humanoid that does it for her: tidying, the dishwasher, wiping surfaces, laundry, fetch and carry, always under supervision. Cloud models decide what to do: Gemini Robotics ER 2 plans, a π model via the Pi API handles manipulation, Gemini 4 Argon builds simulations and data. On the robot, a policy runner on Jetson AGX Thor passes every action through a safety layer to the Unitree G1’s whole-body control and Dex3-1 tactile hands; if the link drops it falls back to GR00T N1.7 or π0.5, or stops safely. A training loop of teleoperated demos, fine-tuning, and evaluation in Isaac Lab and MuJoCo improves it. I promote a skill only at 80% success over 50 trials, with zero safety-stop violations."
  },
